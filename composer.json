{
    "name": "wingman/corvus",
    "type": "library",
    "description": "A hierarchical, pattern-matched event bus featuring wildcard signal routing, predicate-filtered emission, target-scoped listeners, and historical replay support for the Wingman framework.",
    "keywords": ["php", "event-bus", "signals", "pub-sub", "events", "listener", "emitter", "wildcard", "wingman"],
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Angel Politis",
            "email": "info@angelpolitis.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "wingman/strux": ">=1.0"
    },
    "autoload": {
        "psr-4": {
            "Wingman\\Corvus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wingman\\Corvus\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}